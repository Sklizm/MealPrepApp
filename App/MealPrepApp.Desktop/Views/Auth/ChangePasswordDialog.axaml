<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:controls="using:MealPrepApp.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:authvm="using:MealPrepApp.ViewModels.Auth" x:Class="MealPrepApp.Desktop.Views.Auth.ChangePasswordDialog" x:DataType="authvm:ChangePasswordViewModel" Title="{loc:Loc Text.ChangePassword}" Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <controls:DialogLayout>
        <Border Grid.Row="0" Classes="DialogHeading">
            <Grid ColumnDefinitions="32,*"><Path Data="{StaticResource IconProfile}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{loc:Loc Text.ChangePassword}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,8" Spacing="12">
            <TextBlock Text="{loc:Loc Text.CurrentPassword}" Classes="Muted"/>
            <TextBox x:Name="CurrentPasswordBox" PasswordChar="*" RevealPassword="{Binding #CurrentPasswordBoxVisible.IsChecked}"/>
            <CheckBox Name="CurrentPasswordBoxVisible" Content="{loc:Loc Text.ShowPassword}"/>
            <TextBlock Text="{loc:Loc Text.NewPassword}" Classes="Muted"/>
            <TextBox x:Name="NewPasswordBox" PasswordChar="*" RevealPassword="{Binding #NewPasswordBoxVisible.IsChecked}"/>
            <CheckBox Name="NewPasswordBoxVisible" Content="{loc:Loc Text.ShowPassword}"/>
            <TextBlock Text="{loc:Loc Text.ConfirmNewPassword}" Classes="Muted"/>
            <TextBox x:Name="ConfirmPasswordBox" PasswordChar="*" RevealPassword="{Binding #ConfirmPasswordBoxVisible.IsChecked}"/>
            <CheckBox Name="ConfirmPasswordBoxVisible" Content="{loc:Loc Text.ShowPassword}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,4,0,0"/>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Classes="DialogFooter">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc Text.Cancel}" Classes="Secondary DialogCancel" Click="OnCancelClick"/>
                <Button Content="{loc:Loc Text.Save}" Classes="Primary" Click="OnSaveClick" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Border>
    </controls:DialogLayout>
</Window>
