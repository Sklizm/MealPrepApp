<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:authvm="using:MealPrepApp.ViewModels.Auth"
        x:Class="MealPrepApp.Desktop.Views.Auth.ChangePasswordDialog"
        x:DataType="authvm:ChangePasswordViewModel"
        Title="Schimba parola"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CreamBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{StaticResource DarkBrush}" Height="40" Padding="16,0">
            <TextBlock Text="Schimba parola" Foreground="{StaticResource CreamBrush}"
                       FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="1" Margin="20" Spacing="6">
            <TextBlock Text="Parola actuala" Classes="Muted" />
            <TextBox x:Name="CurrentPasswordBox" PasswordChar="*" />

            <TextBlock Text="Parola noua" Classes="Muted" />
            <TextBox x:Name="NewPasswordBox" PasswordChar="*" />

            <TextBlock Text="Confirma parola noua" Classes="Muted" />
            <TextBox x:Name="ConfirmPasswordBox" PasswordChar="*" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding HasError}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Cream2Brush}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Renunta" Classes="Secondary" Click="OnCancelClick" />
                <Button Content="Salveaza" Classes="Primary" Click="OnSaveClick"
                        IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
