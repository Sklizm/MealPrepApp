<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:authvm="using:MealPrepApp.ViewModels.Auth" x:Class="MealPrepApp.Desktop.Views.Auth.ProfileView" x:DataType="authvm:ProfileViewModel" Background="{DynamicResource AppBackground}">
    <Grid Margin="32">
        <StackPanel MaxWidth="460" HorizontalAlignment="Left" Spacing="6">
            <TextBlock Text="{loc:Loc Text.Profile}" Classes="Title" Margin="0,0,0,16"/>
            <Border Classes="Card" DataContext="{Binding Profile}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc Text.Username}" Classes="Muted"/>
                    <TextBlock Text="{Binding Username}" Classes="Body" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc Text.Email}" Classes="Muted"/>
                    <TextBlock Text="{Binding Email}" Classes="Body" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc Text.AccountCreated}" Classes="Muted"/>
                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}" Classes="Body" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc Text.LastSignIn}" Classes="Muted"/>
                    <TextBlock Text="{Binding LastLoginAt, StringFormat='{}{0:g}'}" Classes="Body"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                <Button Content="{loc:Loc Text.ChangePassword}" Classes="Secondary" Command="{Binding ChangePasswordCommand}"/>
                <Button Content="{loc:Loc Text.SignOut}" Classes="Danger" Command="{Binding SignOutCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
