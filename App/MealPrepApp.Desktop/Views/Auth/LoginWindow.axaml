<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MealPrepApp.Desktop.Views.Auth.LoginWindow" Title="{loc:Loc Text.MealprepSignIn}" Width="480" Height="720" MinWidth="440" MinHeight="580" Background="{DynamicResource AppBackground}" WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="32,32,32,0" Spacing="8">
            <TextBlock Text="{loc:Loc Text.Mealprep}" Classes="Title"/>
            <TextBlock Text="{loc:Loc Text.GoodRecipesPlannedMealsMoreTimeForYou}" Classes="Muted" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <ContentControl Name="Host" Margin="32,24"/>
        </ScrollViewer>
        <Button Grid.Row="2" Margin="32,0,32,24" Content="{loc:Loc Text.DatabaseConnection}" Classes="Secondary" Click="EditConnection"/>
    </Grid>
</Window>
