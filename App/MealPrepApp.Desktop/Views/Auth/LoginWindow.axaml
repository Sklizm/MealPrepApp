<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MealPrepApp.Desktop.Views.Auth.LoginWindow" Title="MealPrep • Conectare" Width="480" Height="720" MinWidth="440" MinHeight="580" Background="{DynamicResource AppBackground}" WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="32,32,32,0" Spacing="8">
            <TextBlock Text="MealPrep" Classes="Title"/>
            <TextBlock Text="Rețete bune. Mese planificate. Mai mult timp pentru tine." Classes="Muted" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <ContentControl Name="Host" Margin="32,24"/>
        </ScrollViewer>
        <Button Grid.Row="2" Margin="32,0,32,24" Content="Conexiune la baza de date" Classes="Secondary" Click="EditConnection"/>
    </Grid>
</Window>
