<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:authvm="using:MealPrepApp.ViewModels.Auth" x:Class="MealPrepApp.Desktop.Views.Auth.ForgotPasswordDialog" x:DataType="authvm:ForgotPasswordViewModel" Title="{loc:Loc Text.ResetPassword}" Width="410" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSecondary}" Height="40" Padding="16,0">
            <TextBlock Text="{loc:Loc Text.ResetPassword}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="20" Spacing="6">
            <TextBlock Text="{loc:Loc Text.EnterYourUsernameEmailAndAccountEmailToResetYourPassword}" Foreground="{DynamicResource TextPrimary}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="{loc:Loc Text.UsernameOrEmail}" Classes="Muted"/>
            <TextBox Text="{Binding Identifier}"/>
            <TextBlock Text="{loc:Loc Text.AccountEmail}" Classes="Muted"/>
            <TextBox Text="{Binding Email}"/>
            <TextBlock Text="{loc:Loc Text.NewPassword}" Classes="Muted"/>
            <TextBox x:Name="NewPasswordBox" PasswordChar="*" RevealPassword="{Binding #NewPasswordBoxVisible.IsChecked}"/>
            <CheckBox Name="NewPasswordBoxVisible" Content="{loc:Loc Text.ShowPassword}"/>
            <TextBlock Text="{loc:Loc Text.ConfirmNewPassword}" Classes="Muted"/>
            <TextBox x:Name="ConfirmPasswordBox" PasswordChar="*" RevealPassword="{Binding #ConfirmPasswordBoxVisible.IsChecked}"/>
            <CheckBox Name="ConfirmPasswordBoxVisible" Content="{loc:Loc Text.ShowPassword}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource Surface}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc Text.Cancel}" Classes="Secondary" Click="OnCancelClick"/>
                <Button Content="{loc:Loc Text.ResetPassword28}" Classes="Primary" Click="OnResetClick" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
