<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:authvm="using:MealPrepApp.ViewModels.Auth"
        x:Class="MealPrepApp.Desktop.Views.Auth.ForgotPasswordDialog"
        x:DataType="authvm:ForgotPasswordViewModel"
        Title="Resetare parola"
        Width="410" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CreamBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{StaticResource DarkBrush}" Height="40" Padding="16,0">
            <TextBlock Text="Resetare parola" Foreground="{StaticResource CreamBrush}"
                       FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="1" Margin="20" Spacing="6">
            <TextBlock Text="Introdu utilizatorul/emailul si emailul contului pentru resetare."
                       Foreground="{StaticResource DarkBrush}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,8" />

            <TextBlock Text="Utilizator sau email" Classes="Muted" />
            <TextBox Text="{Binding Identifier}" />

            <TextBlock Text="Email cont" Classes="Muted" />
            <TextBox Text="{Binding Email}" />

            <TextBlock Text="Parola noua" Classes="Muted" />
            <TextBox x:Name="NewPasswordBox" PasswordChar="*" />

            <TextBlock Text="Confirma parola noua" Classes="Muted" />
            <TextBox x:Name="ConfirmPasswordBox" PasswordChar="*" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding HasError}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Cream2Brush}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Renunta" Classes="Secondary" Click="OnCancelClick" />
                <Button Content="Reseteaza parola" Classes="Primary" Click="OnResetClick"
                        IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
