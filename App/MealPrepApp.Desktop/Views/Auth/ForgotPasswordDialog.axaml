<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:authvm="using:MealPrepApp.ViewModels.Auth" x:Class="MealPrepApp.Desktop.Views.Auth.ForgotPasswordDialog" x:DataType="authvm:ForgotPasswordViewModel" Title="Resetare parola" Width="410" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSecondary}" Height="40" Padding="16,0">
            <TextBlock Text="Resetare parola" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="20" Spacing="6">
            <TextBlock Text="Introdu utilizatorul/emailul si emailul contului pentru resetare." Foreground="{DynamicResource TextPrimary}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Utilizator sau email" Classes="Muted"/>
            <TextBox Text="{Binding Identifier}"/>
            <TextBlock Text="Email cont" Classes="Muted"/>
            <TextBox Text="{Binding Email}"/>
            <TextBlock Text="Parolă noua" Classes="Muted"/>
            <TextBox x:Name="NewPasswordBox" PasswordChar="*" RevealPassword="{Binding #NewPasswordBoxVisible.IsChecked}"/>
            <CheckBox Name="NewPasswordBoxVisible" Content="Arată parola"/>
            <TextBlock Text="Confirma parola noua" Classes="Muted"/>
            <TextBox x:Name="ConfirmPasswordBox" PasswordChar="*" RevealPassword="{Binding #ConfirmPasswordBoxVisible.IsChecked}"/>
            <CheckBox Name="ConfirmPasswordBoxVisible" Content="Arată parola"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource Surface}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Renunță" Classes="Secondary" Click="OnCancelClick"/>
                <Button Content="Reseteaza parola" Classes="Primary" Click="OnResetClick" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
