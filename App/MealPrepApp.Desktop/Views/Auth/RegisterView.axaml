<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:authvm="using:MealPrepApp.ViewModels.Auth"
             x:Class="MealPrepApp.Desktop.Views.Auth.RegisterView"
             x:DataType="authvm:RegisterViewModel">

    <StackPanel Spacing="8">
        <TextBlock Text="Cont nou" Classes="Title" Margin="0,0,0,4" />

        <TextBlock Text="Nume utilizator" Classes="Muted" />
        <TextBox Text="{Binding Username}" />

        <TextBlock Text="Email" Classes="Muted" />
        <TextBox Text="{Binding Email}" />

        <TextBlock Text="Parola" Classes="Muted" />
        <TextBox x:Name="PasswordBox" PasswordChar="*" />

        <TextBlock Text="Confirma parola" Classes="Muted" />
        <TextBox x:Name="ConfirmPasswordBox" PasswordChar="*" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding HasError}" />

        <Button Content="Inregistreaza-te" Classes="Primary" Height="38"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Click="OnRegisterClick"
                IsEnabled="{Binding !IsBusy}" Margin="0,6,0,0" />

        <Button Content="Ai cont? Conecteaza-te" Classes="Link"
                HorizontalAlignment="Center"
                Command="{Binding SwitchToLoginCommand}" />
    </StackPanel>
</UserControl>
