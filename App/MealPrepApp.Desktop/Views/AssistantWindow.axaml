<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="using:Avalonia.Data.Converters" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:vm="using:MealPrepApp.ViewModels" xmlns:m="using:MealPrepApp.Models" xmlns:services="using:MealPrepApp.Services"
 x:Class="MealPrepApp.Desktop.Views.AssistantWindow" x:DataType="vm:AssistantViewModel"
 Title="{loc:Loc Ai.Title}" Width="1100" Height="840" MinWidth="820" MinHeight="600" Background="{DynamicResource AppBackground}" WindowStartupLocation="CenterOwner">
 <Window.Styles>
  <Style Selector="TabItem">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Padding" Value="12,8"/>
  </Style>
 </Window.Styles>
 <Window.DataTemplates>
  <DataTemplate DataType="m:Ingredient"><TextBlock Text="{Binding Name}"/></DataTemplate>
  <DataTemplate DataType="m:Unit"><TextBlock Text="{Binding Abbreviation}"/></DataTemplate>
  <DataTemplate DataType="m:Category"><TextBlock Text="{Binding Name}"/></DataTemplate>
  <DataTemplate DataType="m:AiCandidate"><TextBlock Text="{Binding Title}"/></DataTemplate>
 </Window.DataTemplates>
 <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="24,20">
  <TextBlock Text="{loc:Loc Ai.Title}" Classes="Title"/>
  <StackPanel Grid.Row="1" Spacing="4">
   <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
   <ProgressBar IsIndeterminate="{DynamicResource MotionEnabled}" IsVisible="{Binding IsBusy}" Height="3"/>
  </StackPanel>
  <TabControl Grid.Row="2" Name="AssistantTabs" SelectedIndex="{Binding SelectedTab}" Padding="0">
   <TabItem Header="{loc:Loc Ai.Request}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="14" Margin="0,12,4,8" MaxWidth="1024">
      <Expander Header="{loc:Loc Ai.Connection}" IsExpanded="{Binding !Connected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="8">
        <TextBlock Text="{loc:Loc Ai.ConnectionHint}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding Server}" Watermark="https://" AutomationProperties.Name="{loc:Loc Ai.Connection}"/>
        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
         <TextBox Text="{Binding Identifier}" Watermark="{loc:Loc Ai.Account}" AutomationProperties.Name="{loc:Loc Ai.Account}"/>
         <TextBox Grid.Column="1" Name="Password" PasswordChar="●" Watermark="{loc:Loc Ai.Password}" AutomationProperties.Name="{loc:Loc Ai.Password}"/>
         <Button Grid.Column="2" Content="{loc:Loc Ai.Connect}" Classes="Primary" Click="Connect" IsEnabled="{Binding !IsBusy}"/>
        </Grid>
       </StackPanel>
      </Expander>
      <Expander Header="{loc:Loc Ai.Privacy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="8">
        <TextBlock Text="{loc:Loc Ai.Notice}" TextWrapping="Wrap"/>
        <CheckBox Content="{loc:Loc Ai.AcceptNotice}" IsChecked="{Binding AcceptedNotice}"/>
        <Button Content="{loc:Loc Ai.SaveConsent}" Classes="Secondary" Command="{Binding ConsentCommand}" IsEnabled="{Binding Connected}"/>
       </StackPanel>
      </Expander>
      <Border Classes="Card" Padding="18">
       <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
         <StackPanel Spacing="4">
          <TextBlock Text="{loc:Loc Ai.Task}" Classes="Muted"/>
          <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Ai.Task}">
           <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AiTaskOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
         </StackPanel>
         <StackPanel Grid.Column="1" IsVisible="{Binding IsPlanning}" Spacing="4">
          <TextBlock Text="{loc:Loc Ai.WeekStart}" Classes="Muted"/>
          <DatePicker SelectedDate="{Binding StartDate}" AutomationProperties.Name="{loc:Loc Ai.WeekStart}"/>
         </StackPanel>
        </Grid>
        <StackPanel Spacing="4">
         <TextBlock Text="{loc:Loc Ai.Prompt}" Classes="Muted"/>
         <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220" MaxLength="4000" AutomationProperties.Name="{loc:Loc Ai.Prompt}"/>
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding IsTextImport}">
         <TextBlock Text="{loc:Loc Ai.Source}" Classes="Muted"/>
         <TextBox Text="{Binding Source}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="200" MaxLength="200000" AutomationProperties.Name="{loc:Loc Ai.Source}"/>
         <Button Content="{loc:Loc UX.ReviewImport}" Classes="Secondary" Command="{Binding ReviewImportCommand}" IsEnabled="{Binding Connected}"/>
        </StackPanel>
        <Button Content="{loc:Loc Ai.Photo}" Classes="Secondary" Click="ChooseImage" IsVisible="{Binding IsImageRequest}" IsEnabled="{Binding Connected}"/>
        <WrapPanel>
         <Button Content="{loc:Loc Ai.RunTask}" Classes="Primary" Command="{Binding GenerateCommand}" IsEnabled="{Binding Enabled}" Margin="0,0,8,0"/>
         <Button Content="{loc:Loc Ai.Cancel}" Classes="Link" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <Expander Header="{loc:Loc Ai.Preferences}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
         <StackPanel Spacing="4"><TextBlock Text="{loc:Loc Ai.Servings}" Classes="Muted" TextWrapping="Wrap"/><NumericUpDown Value="{Binding Servings}" Minimum="1" Maximum="1000" AutomationProperties.Name="{loc:Loc Ai.Servings}"/></StackPanel>
         <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{loc:Loc Ai.MaxMinutes}" Classes="Muted" TextWrapping="Wrap"/><NumericUpDown Value="{Binding MaxMinutes}" Minimum="1" Maximum="10080" AutomationProperties.Name="{loc:Loc Ai.MaxMinutes}"/></StackPanel>
         <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{loc:Loc Ai.Repetitions}" Classes="Muted" TextWrapping="Wrap"/><NumericUpDown Value="{Binding MaxRepetitions}" Minimum="1" Maximum="7" AutomationProperties.Name="{loc:Loc Ai.Repetitions}"/></StackPanel>
        </Grid>
        <CheckBox Content="{loc:Loc Ai.Expiring}" IsChecked="{Binding PreferExpiring}"/>
        <CheckBox Content="{loc:Loc Ai.Leftovers}" IsChecked="{Binding UseLeftovers}"/>
        <CheckBox Content="{loc:Loc Ai.NewDrafts}" IsChecked="{Binding AllowNewRecipes}"/>
        <TextBlock Text="{loc:Loc Ai.Exclusions}" Classes="Muted"/>
        <ListBox ItemsSource="{Binding AllIngredients}" SelectedItems="{Binding ExcludedIngredients}" SelectionMode="Multiple" MaxHeight="180" AutomationProperties.Name="{loc:Loc Ai.Exclusions}"/>
        <TextBlock Text="{loc:Loc Ai.Slots}" Classes="Muted"/>
        <ListBox ItemsSource="{Binding AllSlots}" SelectedItems="{Binding SelectedSlots}" SelectionMode="Multiple" MaxHeight="140" AutomationProperties.Name="{loc:Loc Ai.Slots}"/>
        <Button Content="{loc:Loc Ai.SavePreferences}" Classes="Secondary" Command="{Binding SavePreferencesCommand}" IsEnabled="{Binding Connected}"/>
       </StackPanel>
      </Expander>
      <Expander Header="{loc:Loc Ai.History}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="10">
        <WrapPanel><Button Content="{loc:Loc Ai.Refresh}" Classes="Secondary" Command="{Binding RefreshCommand}" Margin="0,0,8,4"/><Button Content="{loc:Loc Ai.RecoverPending}" Classes="Secondary" Command="{Binding RecoverPendingCommand}" Margin="0,0,0,4"/></WrapPanel>
        <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" MaxHeight="160">
         <ListBox.ItemTemplate><DataTemplate x:DataType="m:AiJob"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding CreatedAt}"/><TextBlock Text="{Binding Kind}"/><TextBlock Text="{Binding State}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Button Content="{loc:Loc Ai.OpenResult}" Classes="Secondary" Command="{Binding OpenJobCommand}" IsEnabled="{Binding SelectedJob, Converter={StaticResource NotNullToBool}}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{loc:Loc Ai.Suggestions}"><ScrollViewer><StackPanel Spacing="12" Margin="8">
    <TextBlock Text="{loc:Loc Ai.ReadinessHint}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Suggestions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:AiSuggestion"><Border Classes="Card" Margin="0,4"><StackPanel Spacing="8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/><Button Content="{loc:Loc Ai.OpenRecipe}" Command="{CompiledBinding $parent[Window].((vm:AssistantViewModel)DataContext).OpenRecipeCommand}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ItemsControl ItemsSource="{Binding Candidates}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:AiCandidate"><Border Classes="Card" Margin="0,4"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Readiness.Status}"/><TextBlock Text="{Binding Nutrition.PerServingSummary}"/><ItemsControl ItemsSource="{Binding Readiness.Ingredients}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:IngredientShortage"><WrapPanel><TextBlock Text="{Binding Name}" Margin="0,0,10,0"/><TextBlock Text="{Binding Missing}"/></WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{loc:Loc Ai.Recipes}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="0,12,0,0">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <ComboBox Name="ReviewRecipePicker" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" HorizontalAlignment="Stretch" IsVisible="{Binding HasRecipeSelection}" AutomationProperties.Name="{loc:Loc Ai.Recipes}">
       <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:AssistantRecipeRow">
         <Grid>
          <TextBlock Text="{loc:Loc Recipe.Untitled}" IsVisible="{Binding Title, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}"/>
          <TextBlock Text="{Binding Title}" IsVisible="{Binding Title, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </DataTemplate>
       </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="{loc:Loc Ai.NewRecipe}" Classes="Secondary" Command="{Binding NewRecipeCommand}" IsEnabled="{Binding Connected}"/>
     </Grid>
     <Border Grid.Row="1" Classes="Card" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasRecipeSelection}">
      <StackPanel Spacing="10">
       <TextBlock Text="{loc:Loc Ai.RecipeEmpty}" TextWrapping="Wrap" TextAlignment="Center"/>
       <Button Content="{loc:Loc Ai.Request}" Classes="Secondary" HorizontalAlignment="Center" Command="{Binding ShowRequestCommand}"/>
      </StackPanel>
     </Border>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRecipeSelection}">
      <StackPanel Spacing="12" MaxWidth="1024" Margin="0,0,4,8">
       <TextBlock Text="{loc:Loc Ai.ReviewRecipe}" TextWrapping="Wrap"/>
       <ContentControl Content="{Binding SelectedRecipe}">
        <ContentControl.ContentTemplate>
         <DataTemplate x:DataType="vm:AssistantRecipeRow">
          <StackPanel Spacing="12">
           <Border Classes="Card" Padding="16">
            <StackPanel Spacing="10">
             <TextBlock Text="{loc:Loc Recipe.Details}" Classes="Header"/>
             <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
              <StackPanel Spacing="4"><TextBlock Text="{loc:Loc Ai.RecipeTitle}" Classes="Muted"/><TextBox Text="{Binding Title}" MaxLength="150" AutomationProperties.Name="{loc:Loc Ai.RecipeTitle}"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
               <TextBlock Text="{loc:Loc Text.Category}" Classes="Muted"/>
               <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Text.Category}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:Category"><TextBlock Text="{loc:Display Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
               </ComboBox>
              </StackPanel>
             </Grid>
             <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <StackPanel Spacing="4"><TextBlock Text="{loc:Loc Ai.Prep}" Classes="Muted"/><NumericUpDown Value="{Binding PrepMinutes}" Minimum="0" Maximum="10080" AutomationProperties.Name="{loc:Loc Ai.Prep}"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{loc:Loc Ai.Cook}" Classes="Muted"/><NumericUpDown Value="{Binding CookMinutes}" Minimum="0" Maximum="10080" AutomationProperties.Name="{loc:Loc Ai.Cook}"/></StackPanel>
              <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{loc:Loc Ai.Servings}" Classes="Muted"/><NumericUpDown Value="{Binding Servings}" Minimum="1" Maximum="1000" AutomationProperties.Name="{loc:Loc Ai.Servings}"/></StackPanel>
             </Grid>
             <StackPanel Spacing="4"><TextBlock Text="{loc:Loc Ai.Description}" Classes="Muted"/><TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200" MaxLength="500" AutomationProperties.Name="{loc:Loc Ai.Description}"/></StackPanel>
            </StackPanel>
           </Border>
           <Border Classes="Card" Padding="16">
            <StackPanel Spacing="10">
             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{loc:Loc Text.Ingredients}" Classes="Header" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="{loc:Loc Ai.AddIngredient}" Classes="Secondary" Command="{CompiledBinding $parent[Window].((vm:AssistantViewModel)DataContext).AddIngredientCommand}"/>
             </Grid>
             <TextBlock Text="{loc:Loc Text.NoIngredientsAdded}" Classes="Muted" IsVisible="{Binding !Ingredients.Count}" TextWrapping="Wrap"/>
             <ItemsControl ItemsSource="{Binding Ingredients}">
              <ItemsControl.ItemTemplate>
               <DataTemplate x:DataType="vm:AssistantIngredientRow">
                <Border Background="{DynamicResource AppBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                 <StackPanel Spacing="8">
                  <TextBlock Text="{Binding Original}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding Original, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                  <Grid ColumnDefinitions="*,*,112,112" ColumnSpacing="8">
                   <StackPanel Spacing="4"><TextBlock Text="{loc:Loc Ai.IngredientName}" Classes="Muted" TextWrapping="Wrap"/><TextBox Text="{Binding Name}" AutomationProperties.Name="{loc:Loc Ai.IngredientName}"/></StackPanel>
                   <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{loc:Loc Ai.CatalogIngredient}" Classes="Muted" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Ingredients}" SelectedItem="{Binding Ingredient}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Ai.CatalogIngredient}"/></StackPanel>
                   <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{loc:Loc Text.Quantity}" Classes="Muted"/><NumericUpDown Value="{Binding Quantity}" Minimum="0" Maximum="99999999" FormatString="0.####" AutomationProperties.Name="{loc:Loc Text.Quantity}"/></StackPanel>
                   <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="{loc:Loc Text.Unit}" Classes="Muted"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Text.Unit}"/></StackPanel>
                  </Grid>
                  <TextBox Text="{Binding Notes}" Watermark="{loc:Loc Ai.Notes}" AutomationProperties.Name="{loc:Loc Ai.Notes}"/>
                  <Grid ColumnDefinitions="*,Auto">
                   <Button Content="{loc:Loc Ai.CreateIngredient}" Classes="Secondary" Command="{CompiledBinding $parent[Window].((vm:AssistantViewModel)DataContext).CreateIngredientCommand}" CommandParameter="{Binding}" IsVisible="{Binding Ingredient, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                   <Button Grid.Column="1" Content="{loc:Loc Ai.Remove}" Classes="Link DestructiveLink" Command="{CompiledBinding $parent[Window].((vm:AssistantViewModel)DataContext).RemoveIngredientCommand}" CommandParameter="{Binding}"/>
                  </Grid>
                 </StackPanel>
                </Border>
               </DataTemplate>
              </ItemsControl.ItemTemplate>
             </ItemsControl>
            </StackPanel>
           </Border>
           <Border Classes="Card" Padding="16">
            <StackPanel Spacing="8">
             <TextBlock Text="{loc:Loc Ai.Instructions}" Classes="Header"/>
             <TextBox Text="{Binding Instructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="136" MaxHeight="360" AutomationProperties.Name="{loc:Loc Ai.Instructions}"/>
            </StackPanel>
           </Border>
           <Expander Header="{loc:Loc UX.OriginalText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding Source, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
            <TextBox Text="{Binding Source, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180"/>
           </Expander>
          </StackPanel>
         </DataTemplate>
        </ContentControl.ContentTemplate>
       </ContentControl>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0" IsVisible="{Binding HasRecipeSelection}">
      <Button Content="{loc:Loc Ai.SaveRecipe}" Classes="Primary" Command="{Binding SaveRecipeCommand}" HorizontalAlignment="Right" IsEnabled="{Binding !IsBusy}"/>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="{loc:Loc Ai.Plan}"><ScrollViewer><StackPanel Spacing="10" Margin="8">
    <TextBlock Text="{loc:Loc Ai.PlanHint}" TextWrapping="Wrap"/>
    <TextBlock Text="{loc:Loc Ai.ReplaceMeals}"/>
    <ListBox ItemsSource="{Binding ExistingMeals}" SelectedItems="{Binding ReplaceMeals}" SelectionMode="Multiple" MaxHeight="160"><ListBox.ItemTemplate><DataTemplate x:DataType="m:MealPlanEntry"><WrapPanel><TextBlock Text="{Binding PlannedDate}" Margin="0,0,8,0"/><TextBlock Text="{Binding RecipeTitle}"/></WrapPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <ItemsControl ItemsSource="{Binding Meals}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AssistantMealRow"><Border Classes="Card" Margin="0,4"><StackPanel Spacing="6">
     <WrapPanel><DatePicker SelectedDate="{Binding Date}"/><ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" Margin="8,0"/><NumericUpDown Value="{Binding Portions}" Minimum="1" Maximum="1000" Width="100"/></WrapPanel>
     <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding Recipe}" HorizontalAlignment="Stretch"/>
     <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
     <TextBox Text="{Binding BatchKey}" Watermark="{loc:Loc Ai.Batch}"/>
     <CheckBox Content="{loc:Loc Ai.Pin}" IsChecked="{Binding Pinned}"/>
     <Button Content="{loc:Loc Ai.Remove}" Command="{CompiledBinding $parent[Window].((vm:AssistantViewModel)DataContext).RemoveMealCommand}" CommandParameter="{Binding}"/>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <WrapPanel><Button Content="{loc:Loc Ai.AddMeal}" Command="{Binding AddManualMealCommand}"/><Button Content="{loc:Loc Ai.PreviewPlan}" Command="{Binding PreviewPlanCommand}" Margin="8,0"/><Button Content="{loc:Loc Ai.ApplyPlan}" Command="{Binding ApplyPlanCommand}" Margin="8,0"/></WrapPanel>
    <TextBlock Text="{loc:Loc Ai.PlanPreview}" Classes="Header"/>
    <WrapPanel><TextBlock Text="{loc:Loc Ai.Cook}" Margin="0,0,8,0"/><TextBlock Text="{Binding Preview.CookingMinutes}"/><TextBlock Text="kcal" Margin="12,0,8,0"/><TextBlock Text="{Binding Preview.Calories}"/></WrapPanel>
    <TextBlock Text="{loc:Loc Ai.NutritionIncomplete}" IsVisible="{Binding !Preview.NutritionComplete}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Preview.Shopping}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="services:AiPlanShortage"><Grid ColumnDefinitions="2*,*,*,*"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding FromPantry}"/><TextBlock Grid.Column="2" Text="{Binding Missing}"/><TextBlock Grid.Column="3" Text="{Binding Unit}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{loc:Loc Ai.Purchases}"><ScrollViewer><StackPanel Spacing="10" Margin="8">
    <TextBlock Text="{loc:Loc Ai.ReceiptHint}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Purchases}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AssistantPurchaseRow"><Border Classes="Card" Margin="0,4"><StackPanel Spacing="8">
     <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding !Accepted}" Content="{Binding Line.Original}"/>
     <Grid ColumnDefinitions="2*,*,120" ColumnSpacing="8"><ComboBox ItemsSource="{Binding Line.Ingredients}" SelectedItem="{Binding Line.Ingredient}" HorizontalAlignment="Stretch"/><ComboBox Grid.Column="1" ItemsSource="{Binding Line.Units}" SelectedItem="{Binding Line.Unit}" HorizontalAlignment="Stretch"/><NumericUpDown Grid.Column="2" Value="{Binding Line.Quantity}" Minimum="0" Maximum="99999999" FormatString="0.####"/></Grid>
     <WrapPanel><StackPanel><TextBlock Text="{loc:Loc Ai.PurchaseDate}"/><DatePicker SelectedDate="{Binding PurchasedOn}"/></StackPanel><StackPanel Margin="10,0"><TextBlock Text="{loc:Loc Ai.ExpiryDate}"/><DatePicker SelectedDate="{Binding ExpiresOn}"/></StackPanel></WrapPanel>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <CheckBox Content="{loc:Loc Ai.ConfirmDuplicate}" IsChecked="{Binding ConfirmDuplicate}"/>
    <Button Content="{loc:Loc Ai.AcceptPurchases}" Command="{Binding AcceptPurchasesCommand}"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</Window>
