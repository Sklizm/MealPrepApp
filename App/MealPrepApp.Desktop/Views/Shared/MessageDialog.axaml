<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:controls="using:MealPrepApp.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MealPrepApp.Desktop.Views.Shared.MessageDialog" Title="{loc:Loc Text.Message}" Width="460" SizeToContent="Height" MaxHeight="560" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <controls:DialogLayout>
        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Classes="DialogHeading">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock x:Name="HeaderGlyph" Text="!" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}" IsVisible="False" FontWeight="Bold" FontSize="15"/>
                <TextBlock x:Name="HeaderText" Grid.Column="1" TextWrapping="Wrap" Text="{loc:Loc Text.Title249}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="22" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- Body -->
        <ScrollViewer Grid.Row="1" MaxHeight="360">
            <TextBlock x:Name="MessageBody" Text="{loc:Loc Text.Message}" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </ScrollViewer>
        <!-- Actions -->
        <Border Grid.Row="2" Classes="DialogFooter">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Content="{loc:Loc Text.No}" Classes="Secondary DialogCancel" Click="OnCancelClick"/>
                <Button x:Name="OkButton" Content="{loc:Loc Text.Yes}" Classes="Primary" Click="OnOkClick"/>
            </StackPanel>
        </Border>
    </controls:DialogLayout>
</Window>
