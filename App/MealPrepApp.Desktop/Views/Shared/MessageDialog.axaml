<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MealPrepApp.Desktop.Views.Shared.MessageDialog" Title="{loc:Loc Text.Message}" Width="420" SizeToContent="Height" MaxHeight="640" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="{DynamicResource SurfaceSecondary}" Height="40" Padding="14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderGlyph" Text="!" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}" IsVisible="False" FontWeight="Bold" FontSize="15"/>
                <TextBlock x:Name="HeaderText" Text="{loc:Loc Text.Title249}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <!-- Body -->
        <ScrollViewer Grid.Row="1" MaxHeight="460">
            <TextBlock x:Name="MessageBody" Text="{loc:Loc Text.Message}" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap" Margin="20,18,20,14"/>
        </ScrollViewer>
        <!-- Actions -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Content="{loc:Loc Text.No}" Classes="Secondary" Click="OnCancelClick"/>
                <Button x:Name="OkButton" Content="{loc:Loc Text.Yes}" Classes="Primary" Click="OnOkClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
