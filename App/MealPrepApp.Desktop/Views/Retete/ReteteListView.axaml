<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MealPrepApp.ViewModels.Retete"
             xmlns:models="using:MealPrepApp.Models"
             x:Class="MealPrepApp.Desktop.Views.Retete.ReteteListView"
             x:DataType="vm:ReteteListViewModel"
             Background="{StaticResource CreamBrush}">

    <Grid ColumnDefinitions="180,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource DarkBrush}">
            <StackPanel Margin="0,16,0,0" Spacing="4">
                <RadioButton Content="Toate" Classes="Tab" GroupName="ReteteFilter"
                             Command="{Binding ShowToateCommand}"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEquals}, ConverterParameter=Toate}" />
                <RadioButton Content="Favorite" Classes="Tab" GroupName="ReteteFilter"
                             Command="{Binding ShowFavoriteCommand}"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEquals}, ConverterParameter=Favorite}" />
                <RadioButton Content="Recente" Classes="Tab" GroupName="ReteteFilter"
                             Command="{Binding ShowRecenteCommand}"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEquals}, ConverterParameter=Recente}" />
                <RadioButton Content="Drafts" Classes="Tab" GroupName="ReteteFilter"
                             Command="{Binding ShowDraftsCommand}"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEquals}, ConverterParameter=Drafts}" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="24" RowDefinitions="Auto,Auto,*">
            <!-- Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0" Text="Retete" Classes="Title"
                           VerticalAlignment="Center" Margin="0,0,24,0" />

                <TextBox Grid.Column="1" Watermark="Cauta retete..."
                         Text="{Binding SearchTerm}"
                         VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left" />

                <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          VerticalAlignment="Center" Width="170" Margin="8,0,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="3" Content="+ Adauga reteta" Classes="Primary"
                        Command="{Binding CreateRecipeCommand}" Margin="8,0,0,0" />
            </Grid>

            <!-- Error message -->
            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       IsVisible="{Binding HasError}" />

            <!-- Recipes List -->
            <Grid Grid.Row="2" IsVisible="{Binding IsShowingRecipes}">
                <ScrollViewer IsVisible="{Binding Recipes.Count, Converter={StaticResource NonEmptyToBool}}">
                    <ItemsControl ItemsSource="{Binding Recipes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeListItem">
                                <Border Classes="Card" Width="240" Margin="0,0,16,16" Padding="14">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        <!-- Photo -->
                                        <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True" Height="110"
                                                Margin="0,0,0,10"
                                                IsVisible="{Binding PhotoData, Converter={StaticResource NotNullToBool}}">
                                            <Image Source="{Binding PhotoData, Converter={StaticResource ByteArrayToBitmap}}"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Title & actions -->
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Content="{Binding Title}" Classes="Link"
                                                    HorizontalAlignment="Left" FontWeight="SemiBold"
                                                    Command="{Binding $parent[ItemsControl].((vm:ReteteListViewModel)DataContext).OpenRecipeCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="1" Content="✕" Classes="Link"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ReteteListViewModel)DataContext).DeleteRecipeCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <!-- Category -->
                                        <Border Grid.Row="2" Background="{StaticResource MossBrush}" CornerRadius="3"
                                                Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                IsVisible="{Binding CategoryName, Converter={StaticResource NotNullToBool}}">
                                            <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource CreamBrush}"
                                                       FontSize="11" />
                                        </Border>

                                        <!-- Times & Servings -->
                                        <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="2">
                                            <TextBlock Classes="Muted"
                                                       Text="{Binding PrepTimeMinutes, StringFormat='Preparare: {0} min'}" />
                                            <TextBlock Classes="Muted"
                                                       Text="{Binding CookTimeMinutes, StringFormat='Gatire: {0} min'}" />
                                            <TextBlock Classes="Muted"
                                                       Text="{Binding Servings, StringFormat='Portii: {0}'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border Classes="Card" VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsVisible="{Binding Recipes.Count, Converter={StaticResource EmptyToBool}}">
                    <StackPanel Margin="16" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="Nicio reteta" Classes="Header" HorizontalAlignment="Center" />
                        <TextBlock Text="Adauga prima ta reteta pentru a incepe." Classes="Muted" HorizontalAlignment="Center" />
                        <Button Content="+ Adauga reteta" Classes="Primary"
                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                Command="{Binding CreateRecipeCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Drafts List -->
            <Grid Grid.Row="2" IsVisible="{Binding IsShowingDrafts}">
                <ScrollViewer IsVisible="{Binding Drafts.Count, Converter={StaticResource NonEmptyToBool}}">
                    <ItemsControl ItemsSource="{Binding Drafts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeDraftListItem">
                                <Border Classes="Card" Width="240" Margin="0,0,16,16" Padding="14">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Content="{Binding Title, FallbackValue='Draft fara titlu'}"
                                                    Classes="Link" HorizontalAlignment="Left" FontWeight="SemiBold"
                                                    Command="{Binding $parent[ItemsControl].((vm:ReteteListViewModel)DataContext).OpenDraftCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="1" Content="✕" Classes="Link"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ReteteListViewModel)DataContext).DeleteDraftCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <Border Grid.Row="1" Background="{StaticResource MossBrush}" CornerRadius="3"
                                                Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                IsVisible="{Binding CategoryName, Converter={StaticResource NotNullToBool}}">
                                            <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource CreamBrush}"
                                                       FontSize="11" />
                                        </Border>

                                        <TextBlock Grid.Row="2" Classes="Muted" Margin="0,8,0,0"
                                                   Text="{Binding UpdatedAt, StringFormat='Actualizata: {0:dd.MM.yyyy HH:mm}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty draft state -->
                <Border Classes="Card" VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsVisible="{Binding Drafts.Count, Converter={StaticResource EmptyToBool}}">
                    <StackPanel Margin="16" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="Niciun draft" Classes="Header" HorizontalAlignment="Center" />
                        <TextBlock Text="Salveaza o reteta ca draft din editor si revino aici cand vrei sa o termini."
                                   Classes="Muted" HorizontalAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
