<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:vm="using:MealPrepApp.ViewModels.Retete" xmlns:models="using:MealPrepApp.Models" x:Class="MealPrepApp.Desktop.Views.Retete.FinishCookingDialog" x:DataType="vm:FinishCookingDialogViewModel" Title="{loc:Loc UX.FinishCooking}" Width="600" Height="600" MinWidth="420" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
 <Grid RowDefinitions="*,Auto" Margin="20">
  <ScrollViewer><StackPanel Spacing="10">
   <TextBlock Text="{loc:Loc UX.FinishCooking}" Classes="Header"/>
   <TextBlock Text="{loc:Loc UX.CookingReviewHint}" Classes="Muted" TextWrapping="Wrap"/>
   <TextBlock Text="{loc:Loc UX.ProducedPortions}"/>
   <NumericUpDown Value="{Binding ProducedPortions}" Minimum="0.0001" Maximum="1000" AutomationProperties.Name="{loc:Loc UX.ProducedPortions}"/>
   <TextBlock Text="{loc:Loc UX.ConsumedNow}"/>
   <NumericUpDown Value="{Binding ConsumedPortions}" Minimum="0" Maximum="1000" AutomationProperties.Name="{loc:Loc UX.ConsumedNow}"/>
   <TextBlock Text="{loc:Loc UX.OptionalExpiry}"/>
   <loc:LocalizedCalendarDatePicker SelectedDate="{Binding ExpiresOn}"/>
   <CheckBox Content="{loc:Loc UX.IncludeExpired}" IsChecked="{Binding IncludeExpired}"/>
   <TextBlock Text="{loc:Loc UX.IngredientDeductions}" FontWeight="SemiBold"/>
   <ItemsControl ItemsSource="{Binding Deductions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ReviewedStockLine">
    <Grid ColumnDefinitions="*,120,60" Margin="0,4">
     <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Batch.IngredientName}"/>
     <NumericUpDown Grid.Column="1" Value="{Binding Quantity}" Minimum="0.0001" Maximum="{Binding Batch.RemainingQuantity}" FormatString="0.####" AutomationProperties.Name="{loc:Loc Text.Quantity}"/>
     <TextBlock Grid.Column="2" Text="{Binding Batch.UnitAbbreviation}" VerticalAlignment="Center" Margin="8,0"/>
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <ItemsControl ItemsSource="{Binding Shortages}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:IngredientShortage"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Name}"/><TextBlock Text="{loc:Format UX.ShortageAmount, Missing}" Foreground="{DynamicResource Danger}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <CheckBox IsVisible="{Binding NeedsReview}" IsChecked="{Binding AcceptIncompleteDeductions}" Content="{loc:Loc UX.AcceptIncompleteDeductions}"/>
   <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
   <Button Content="{loc:Loc Text.Cancel}" Classes="Secondary" Click="Cancel"/>
   <Button Content="{loc:Loc UX.FinishCooking}" Classes="Primary" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
  </StackPanel>
 </Grid>
</Window>
