<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:images="using:MealPrepApp.Desktop.Controls"
             xmlns:vm="using:MealPrepApp.ViewModels.Retete" xmlns:models="using:MealPrepApp.Models"
             x:Class="MealPrepApp.Desktop.Views.Retete.ReteteEditorView" x:DataType="vm:ReteteEditorViewModel"
             Background="{DynamicResource AppBackground}">
    <Grid Margin="24,20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding ScreenTitle}" Classes="Title" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{loc:Loc Ai.Title}" Classes="Secondary" Click="OpenAssistant" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1024" Margin="0,0,4,8" Spacing="14">
                <Border Classes="Card" IsVisible="{Binding CanRestoreRecovery}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc UX.RecoveryAvailable}" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Button Content="{loc:Loc UX.RestoreEdit}" Command="{Binding RestoreRecoveryCommand}" Classes="Primary" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc UX.DiscardRecovery}" Command="{Binding DismissRecoveryCommand}" Classes="Secondary"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Loc UX.RecoverySaveFailed}" Foreground="{DynamicResource Danger}" IsVisible="{Binding RecoverySaveFailed}" TextWrapping="Wrap"/>
                <Expander Header="{loc:Loc UX.ImportRecipe}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc UX.ImportHint}" Classes="Muted" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding ImportInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200" MaxLength="200000" AutomationProperties.Name="{loc:Loc UX.ImportRecipe}"/>
                        <Button Content="{loc:Loc UX.ReviewImport}" Command="{Binding ReviewImportCommand}" Classes="Secondary" IsEnabled="{Binding !IsBusy}"/>
                        <StackPanel IsVisible="{Binding HasImportReview}" Spacing="8">
                            <TextBlock Text="{Binding ImportReview.Title}" Classes="Header" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Loc UX.ImportReviewHint}" Classes="Muted" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,112,110" ColumnSpacing="8">
                                <TextBlock Text="{loc:Loc Text.Ingredient}" Classes="Muted"/>
                                <TextBlock Grid.Column="1" Text="{loc:Loc Text.Unit}" Classes="Muted"/>
                                <TextBlock Grid.Column="2" Text="{loc:Loc Text.Quantity}" Classes="Muted"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ImportReviewRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecipeIngredientRowViewModel">
                                        <Grid ColumnDefinitions="*,112,110" ColumnSpacing="8" Margin="0,0,0,6">
                                            <AutoCompleteBox ItemsSource="{Binding AllIngredients}" Text="{Binding IngredientText}" SelectedItem="{Binding SelectedIngredient}" ValueMemberBinding="{Binding Name}" FilterMode="Contains" MinimumPrefixLength="0" AutomationProperties.Name="{loc:Loc Text.Ingredient}">
                                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="models:Ingredient"><TextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                                            </AutoCompleteBox>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AllUnits}" SelectedItem="{Binding SelectedUnit}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Text.Unit}">
                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="models:Unit"><TextBlock Text="{Binding Abbreviation}"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <NumericUpDown Grid.Column="2" Value="{Binding Quantity}" Minimum="0" Maximum="99999999" FormatString="0.####" AutomationProperties.Name="{loc:Loc Text.Quantity}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="{loc:Loc UX.OriginalText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBox Text="{Binding ImportReview.Original, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180"/>
                            </Expander>
                            <Button Content="{loc:Loc UX.UseReviewedDraft}" Command="{Binding ApplyImportCommand}" Classes="Primary"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Loc Recipe.Details}" Classes="Header"/>
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc Text.Title}" Classes="Muted"/>
                                <TextBox Name="RecipeName" Text="{Binding Title}" MaxLength="150" AutomationProperties.Name="{loc:Loc Text.Title}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{loc:Loc Text.Category}" Classes="Muted"/>
                                <ComboBox Name="RecipeCategory" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="{loc:Loc Text.Category}">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:Category"><TextBlock Text="{loc:Display Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc Text.PreparationMin}" Classes="Muted" TextWrapping="Wrap"/>
                                <NumericUpDown Value="{Binding PrepTimeMinutes}" Minimum="0" Maximum="10080" FormatString="0" AutomationProperties.Name="{loc:Loc Text.PreparationMin}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{loc:Loc Text.CookingMin}" Classes="Muted" TextWrapping="Wrap"/>
                                <NumericUpDown Value="{Binding CookTimeMinutes}" Minimum="0" Maximum="10080" FormatString="0" AutomationProperties.Name="{loc:Loc Text.CookingMin}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{loc:Loc Text.Servings}" Classes="Muted" TextWrapping="Wrap"/>
                                <NumericUpDown Value="{Binding Servings}" Minimum="1" Maximum="1000" FormatString="0" AutomationProperties.Name="{loc:Loc Text.Servings}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Text.Description}" Classes="Muted"/>
                            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180" MaxLength="500" AutomationProperties.Name="{loc:Loc Text.Description}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{loc:Loc Text.Ingredients}" Classes="Header" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{loc:Loc Text.AddIngredient121}" Classes="Secondary" Command="{Binding AddIngredientRowCommand}"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc Text.NoIngredientsAdded}" Classes="Muted" IsVisible="{Binding IngredientRows.Count, Converter={StaticResource EmptyToBool}}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="2*,100,112,*,36" ColumnSpacing="8" IsVisible="{Binding IngredientRows.Count, Converter={StaticResource NonEmptyToBool}}">
                            <TextBlock Text="{loc:Loc Text.Ingredient}" Classes="Muted"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Text.Unit}" Classes="Muted"/>
                            <TextBlock Grid.Column="2" Text="{loc:Loc Text.Quantity}" Classes="Muted" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="3" Text="{loc:Loc Text.Notes}" Classes="Muted"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding IngredientRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecipeIngredientRowViewModel">
                                    <Grid ColumnDefinitions="2*,100,112,*,36" ColumnSpacing="8" Margin="0,0,0,6">
                                        <AutoCompleteBox ItemsSource="{Binding AllIngredients}" Text="{Binding IngredientText}" SelectedItem="{Binding SelectedIngredient}" ValueMemberBinding="{Binding Name}" FilterMode="Contains" MinimumPrefixLength="0" Watermark="{loc:Loc Text.SearchIngredient}" AutomationProperties.Name="{loc:Loc Text.Ingredient}">
                                            <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="models:Ingredient"><TextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AllUnits}" SelectedItem="{Binding SelectedUnit}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Text.Unit}">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="models:Unit"><TextBlock Text="{Binding Abbreviation}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <NumericUpDown Grid.Column="2" Value="{Binding Quantity}" Minimum="0" Maximum="99999999" Increment="1" FormatString="0.####" AutomationProperties.Name="{loc:Loc Text.Quantity}"/>
                                        <TextBox Grid.Column="3" Text="{Binding Notes}" AutomationProperties.Name="{loc:Loc Text.Notes}"/>
                                        <Button Grid.Column="4" AutomationProperties.Name="{loc:Loc Text.Delete}" ToolTip.Tip="{loc:Loc Text.Delete}" Classes="Link DestructiveLink" Width="36" Padding="8" HorizontalContentAlignment="Center" Command="{Binding RemoveCommand}">
                                            <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Danger}" StrokeThickness="1.7"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc UX.CreateIngredient}" Command="{Binding CreateInlineIngredientCommand}" Classes="Link" Padding="0,8"/>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc Text.Instructions}" Classes="Header"/>
                        <TextBox Text="{Binding Instructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="360" AutomationProperties.Name="{loc:Loc Text.Instructions}"/>
                    </StackPanel>
                </Border>
                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{loc:Loc Text.Photo}" Classes="Header" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Loc Text.AddPhoto}" Command="{Binding SelectPhotoCommand}" Classes="Secondary"/>
                                <Button Content="{loc:Loc UX.RemovePhoto}" Command="{Binding RemovePhotoCommand}" Classes="Link DestructiveLink" IsVisible="{Binding PhotoBytes, Converter={StaticResource NotNullToBool}}"/>
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="8" ClipToBounds="True" Height="180" HorizontalAlignment="Left" IsVisible="{Binding PhotoBytes, Converter={StaticResource NotNullToBool}}">
                            <images:RecipeImage Bytes="{Binding PhotoBytes}" DecodePixelWidth="480" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Expander Header="{loc:Loc UX.OriginalText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding SourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                    <TextBox Text="{Binding SourceText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="180" TextWrapping="Wrap"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                <TextBlock Text="{Binding Notification}" Foreground="{DynamicResource ActionPrimary}" TextWrapping="Wrap" IsVisible="{Binding Notification, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="{DynamicResource MotionEnabled}" Height="3"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Button Content="{loc:Loc Text.Cancel}" Classes="Link" Command="{Binding CancelCommand}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Loc Text.SaveAsDraft}" Classes="Secondary" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="{loc:Loc Text.Save}" Classes="Primary" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
