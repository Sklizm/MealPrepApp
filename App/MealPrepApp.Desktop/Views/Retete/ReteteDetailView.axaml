<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MealPrepApp.ViewModels.Retete" xmlns:models="using:MealPrepApp.Models" xmlns:services="using:MealPrepApp.Services" xmlns:images="using:MealPrepApp.Desktop.Controls" x:Class="MealPrepApp.Desktop.Views.Retete.ReteteDetailView" x:DataType="vm:ReteteDetailViewModel" Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="32">
        <WrapPanel>
            <Button Content="{loc:Loc Text.BackToRecipes}" Classes="Link" Command="{Binding BackCommand}"/>
            <Button Content="{Binding FavoriteLabel}" Classes="Secondary" Command="{Binding ToggleFavoriteCommand}" Margin="8,0,0,8"/>
            <Button Content="{loc:Loc Text.Edit}" Classes="Secondary" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" Margin="8,0,0,8"/>
            <Button Content="{loc:Loc Text.DeleteRecipe}" Classes="Link DestructiveLink" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}" Margin="8,0,0,8"/>
        </WrapPanel>
        <StackPanel Grid.Row="1">
            <ProgressBar Height="4" IsIndeterminate="{DynamicResource MotionEnabled}" IsVisible="{Binding IsBusy}"/>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" IsVisible="{Binding HasError}"/>
            <Button Classes="Primary" Content="{loc:Loc Text.Reload}" Command="{Binding RetryCommand}" IsVisible="{Binding HasError}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="24" MaxWidth="1024" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Display Recipe.CategoryName}" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding Recipe.Title}" Classes="Title" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Recipe.Description}" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <TextBlock Text="{loc:Format Recipe.PrepTime, Recipe.PrepTimeMinutes}" Classes="Muted" Margin="0,0,24,0"/>
                        <TextBlock Text="{loc:Format Recipe.CookTime, Recipe.CookTimeMinutes}" Classes="Muted" Margin="0,0,24,0"/>
                        <TextBlock Text="{loc:Format Recipe.Author, Recipe.AuthorUsername}" Classes="Muted"/>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel>
                    <Button Classes="Primary" Content="{loc:Loc Text.Cook}" Command="{Binding CookCommand}" Margin="0,0,8,8"/>
                    <Button Content="{loc:Loc Text.AddToPlan}" Classes="Secondary" Command="{Binding AddToPlanCommand}" Margin="0,0,8,8"/>
                    <Button Content="{Binding PhotoLabel}" Classes="Link" Command="{Binding ChoosePhotoCommand}" IsVisible="{Binding CanEdit}" Margin="0,0,8,8"/>
                    <Button Content="{loc:Loc Text.RemovePhoto}" Classes="Link DestructiveLink" Command="{Binding DeletePhotoCommand}" IsVisible="{Binding CanEdit}" Margin="0,0,8,8"/>
                </WrapPanel>
                <Border Classes="Card" Padding="0" Height="240" ClipToBounds="True" IsVisible="{Binding HasPhoto}">
                    <images:RecipeImage Bytes="{Binding PhotoBytes}" Stretch="UniformToFill"/>
                </Border>
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Loc Text.Ingredients}" Classes="Header"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Text.Servings}" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding SelectedServings}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="116" IsEnabled="{Binding CanScale}" AutomationProperties.Name="{loc:Loc Text.NumberOfServings}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc Text.ScalingRequiresAValidBaseServingCount}" Classes="Muted" IsVisible="{Binding CanScale, Converter={StaticResource InverseBool}}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding ScaledIngredients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:CookingIngredient">
                                    <Grid ColumnDefinitions="*,Auto,80" Margin="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Notes}" Classes="Muted" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0:0.##}'}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="8,0,0,0" Classes="Muted"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc Text.Instructions}" Classes="Header"/>
                    <TextBlock Text="{Binding Recipe.Instructions}" TextWrapping="Wrap" FontSize="16" LineHeight="28"/>
                </StackPanel>
                <Border Classes="Card" IsVisible="{Binding ScaledNutrition, Converter={StaticResource NotNullToBool}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Loc Text.EstimatedNutritionTotalForSelectedServings}" Classes="Header" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <TextBlock Text="{loc:Format Nutrition.Calories, ScaledNutrition.TotalCalories}" Margin="0,0,24,0"/>
                            <TextBlock Text="{loc:Format Nutrition.Protein, ScaledNutrition.TotalProteinGrams}" Margin="0,0,24,0"/>
                            <TextBlock Text="{loc:Format Nutrition.Carbs, ScaledNutrition.TotalCarbsGrams}" Margin="0,0,24,0"/>
                            <TextBlock Text="{loc:Format Nutrition.Fat, ScaledNutrition.TotalFatGrams}"/>
                        </WrapPanel>
                        <TextBlock Text="{loc:Loc Text.IncompleteEstimateSomeIngredientsLackNutritionDataOrCompatibleUnits}" Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding ScaledNutrition.HasCompleteNutrition, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
