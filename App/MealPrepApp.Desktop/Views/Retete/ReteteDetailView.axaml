<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MealPrepApp.ViewModels.Retete" xmlns:models="using:MealPrepApp.Models" xmlns:services="using:MealPrepApp.Services" xmlns:images="using:MealPrepApp.Desktop.Controls" x:Class="MealPrepApp.Desktop.Views.Retete.ReteteDetailView" x:DataType="vm:ReteteDetailViewModel" Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="32">
        <WrapPanel>
            <Button Content="Înapoi la rețete" Classes="Link" Command="{Binding BackCommand}"/>
            <Button Content="{Binding FavoriteLabel}" Classes="Secondary" Command="{Binding ToggleFavoriteCommand}" Margin="8,0,0,8"/>
            <Button Content="Editează" Classes="Secondary" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" Margin="8,0,0,8"/>
            <Button Content="Șterge rețeta" Classes="Link" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}" Margin="8,0,0,8"/>
        </WrapPanel>
        <StackPanel Grid.Row="1">
            <ProgressBar Height="4" IsIndeterminate="{DynamicResource MotionEnabled}" IsVisible="{Binding IsBusy}"/>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" IsVisible="{Binding HasError}"/>
            <Button Classes="Primary" Content="Reîncarcă" Command="{Binding RetryCommand}" IsVisible="{Binding HasError}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="24" MaxWidth="1024" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Recipe.CategoryName}" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding Recipe.Title}" Classes="Title" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Recipe.Description}" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <TextBlock Text="{Binding Recipe.PrepTimeMinutes, StringFormat='Preparare: {0} min'}" Classes="Muted" Margin="0,0,24,0"/>
                        <TextBlock Text="{Binding Recipe.CookTimeMinutes, StringFormat='Gătire: {0} min'}" Classes="Muted" Margin="0,0,24,0"/>
                        <TextBlock Text="{Binding Recipe.AuthorUsername, StringFormat='De {0}'}" Classes="Muted"/>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel>
                    <Button Classes="Primary" Content="Gătește" Command="{Binding CookCommand}" Margin="0,0,8,8"/>
                    <Button Content="Adaugă în plan" Classes="Secondary" Command="{Binding AddToPlanCommand}" Margin="0,0,8,8"/>
                    <Button Content="{Binding PhotoLabel}" Classes="Link" Command="{Binding ChoosePhotoCommand}" IsVisible="{Binding CanEdit}" Margin="0,0,8,8"/>
                    <Button Content="Șterge fotografia" Classes="Link" Command="{Binding DeletePhotoCommand}" IsVisible="{Binding CanEdit}" Margin="0,0,8,8"/>
                </WrapPanel>
                <Border Classes="Card" Padding="0" Height="240" ClipToBounds="True" IsVisible="{Binding HasPhoto}">
                    <images:RecipeImage Bytes="{Binding PhotoBytes}" Stretch="UniformToFill"/>
                </Border>
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Ingrediente" Classes="Header"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Porții" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding SelectedServings}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="116" IsEnabled="{Binding CanScale}" AutomationProperties.Name="Număr de porții"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Scalarea necesită un număr de porții de bază valid." Classes="Muted" IsVisible="{Binding CanScale, Converter={StaticResource InverseBool}}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding ScaledIngredients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:CookingIngredient">
                                    <Grid ColumnDefinitions="*,Auto,80" Margin="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Notes}" Classes="Muted" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0:0.##}'}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="8,0,0,0" Classes="Muted"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="12">
                    <TextBlock Text="Mod de preparare" Classes="Header"/>
                    <TextBlock Text="{Binding Recipe.Instructions}" TextWrapping="Wrap" FontSize="16" LineHeight="28"/>
                </StackPanel>
                <Border Classes="Card" IsVisible="{Binding ScaledNutrition, Converter={StaticResource NotNullToBool}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Nutriție estimată • total pentru porțiile selectate" Classes="Header" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding ScaledNutrition.TotalCalories, StringFormat='{}{0:0.##} kcal'}" Margin="0,0,24,0"/>
                            <TextBlock Text="{Binding ScaledNutrition.TotalProteinGrams, StringFormat='Proteine: {0:0.##} g'}" Margin="0,0,24,0"/>
                            <TextBlock Text="{Binding ScaledNutrition.TotalCarbsGrams, StringFormat='Carbohidrați: {0:0.##} g'}" Margin="0,0,24,0"/>
                            <TextBlock Text="{Binding ScaledNutrition.TotalFatGrams, StringFormat='Grăsimi: {0:0.##} g'}"/>
                        </WrapPanel>
                        <TextBlock Text="Estimare incompletă: unele ingrediente nu au date nutritive sau unități compatibile." Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding ScaledNutrition.HasCompleteNutrition, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
