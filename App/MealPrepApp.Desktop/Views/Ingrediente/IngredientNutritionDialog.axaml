<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:controls="using:MealPrepApp.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MealPrepApp.ViewModels.Ingrediente" xmlns:models="using:MealPrepApp.Models" x:Class="MealPrepApp.Desktop.Views.Ingrediente.IngredientNutritionDialog" x:DataType="vm:IngredientNutritionDialogViewModel" Title="{loc:Loc Text.IngredientNutrition}" Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <controls:DialogLayout>
        <Border Grid.Row="0" Classes="DialogHeading">
            <Grid ColumnDefinitions="32,*"><Path Data="{StaticResource IconIngredient}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{loc:Loc Text.IngredientNutrition104}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,8" Spacing="12">
            <TextBlock Text="{Binding IngredientName}" Classes="Header"/>
            <TextBlock Text="{loc:Loc Text.EnterNutritionValuesForAStandardQuantity}" Classes="Muted" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc Text.BaseQuantity}" Classes="Muted"/>
                    <TextBox Text="{Binding BasisQuantity}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{loc:Loc Text.BaseUnit}" Classes="Muted"/>
                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Unit">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Text.Calories}" Classes="Muted"/>
                <TextBox Text="{Binding Calories}"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,10,*,10,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc Text.ProteinG}" Classes="Muted"/>
                    <TextBox Text="{Binding ProteinGrams}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{loc:Loc Text.CarbohydratesG}" Classes="Muted"/>
                    <TextBox Text="{Binding CarbsGrams}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="4">
                    <TextBlock Text="{loc:Loc Text.FatG}" Classes="Muted"/>
                    <TextBox Text="{Binding FatGrams}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,4,0,0"/>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Classes="DialogFooter">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc Text.Cancel}" Classes="Secondary DialogCancel" Click="OnCancelClick"/>
                <Button Content="{loc:Loc Text.Save}" Classes="Primary" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Border>
    </controls:DialogLayout>
</Window>
