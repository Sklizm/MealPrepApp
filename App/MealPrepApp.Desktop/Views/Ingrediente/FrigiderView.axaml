<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MealPrepApp.ViewModels.Ingrediente"
             xmlns:models="using:MealPrepApp.Models"
             x:Class="MealPrepApp.Desktop.Views.Ingrediente.FrigiderView"
             x:DataType="vm:FrigiderViewModel"
             Background="{StaticResource CreamBrush}">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="Frigider" Classes="Title" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="+ Adauga in frigider" Classes="Primary"
                    Command="{Binding AddItemCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   IsVisible="{Binding HasError}" />

        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Items}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      IsVisible="{Binding Items.Count, Converter={StaticResource NonEmptyToBool}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="*" />
                    <DataGridTextColumn Header="Cantitate" Binding="{Binding Quantity, StringFormat={}{0:0.##}}" Width="100" />
                    <DataGridTextColumn Header="Unitate" Binding="{Binding UnitAbbreviation}" Width="100" />
                    <DataGridTextColumn Header="Adaugat" Binding="{Binding AddedAt, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120" />
                    <DataGridTemplateColumn Header="" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:PantryItem">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0">
                                    <Button Content="Editeaza" Classes="Secondary" Padding="8,3" FontSize="11"
                                            Command="{Binding $parent[DataGrid].((vm:FrigiderViewModel)DataContext).EditItemCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Sterge" Classes="Danger" Padding="8,3" FontSize="11"
                                            Command="{Binding $parent[DataGrid].((vm:FrigiderViewModel)DataContext).RemoveItemCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Classes="Card" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsVisible="{Binding Items.Count, Converter={StaticResource EmptyToBool}}">
                <StackPanel Margin="16" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="Frigiderul este gol" Classes="Header" HorizontalAlignment="Center" />
                    <TextBlock Text="Adauga produsele pe care le ai in stoc." Classes="Muted" HorizontalAlignment="Center" />
                    <Button Content="+ Adauga in frigider" Classes="Primary"
                            HorizontalAlignment="Center" Margin="0,10,0,0"
                            Command="{Binding AddItemCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
