<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MealPrepApp.ViewModels.Ingrediente" xmlns:models="using:MealPrepApp.Models" xmlns:controls="using:MealPrepApp.Desktop.Controls" x:Class="MealPrepApp.Desktop.Views.Ingrediente.FrigiderView" x:DataType="vm:FrigiderViewModel" Background="{DynamicResource AppBackground}">
    <UserControl.Styles>
        <Style Selector="UniformGrid"><Setter Property="Columns" Value="2"/></Style>
        <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
        <Style Selector="controls|FridgeFoodIllustration">
            <Setter Property="Width" Value="72"/><Setter Property="Height" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector=".compact controls|FridgeFoodIllustration"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="36"/></Style>
        <Style Selector=".compact UniformGrid"><Setter Property="Columns" Value="4"/></Style>
        <Style Selector="TextBlock.FoodName">
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.FoodCount"><Setter Property="Height" Value="16"/><Setter Property="LineHeight" Value="16"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/></Style>
        <Style Selector="Border.FoodNameSlot"><Setter Property="Height" Value="32"/></Style>
        <Style Selector=".compact Border.FoodNameSlot"><Setter Property="Height" Value="14"/></Style>
        <Style Selector=".compact TextBlock.FoodName"><Setter Property="LineHeight" Value="14"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style Selector=".compact TextBlock.FridgeHint"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="Button.food">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Button.food.selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource ActionPrimary}"/></Style>
        <Style Selector="Button.StockIcon"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </UserControl.Styles>
    <Grid Margin="32" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="2"><TextBlock Text="{loc:Loc Text.Pantry}" Classes="Title"/><TextBlock Text="{Binding StockSummary}" Classes="Muted"/></StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="{loc:Loc Text.WhatCanICook}" Classes="Secondary" Command="{Binding CookCommand}" Margin="0,0,8,0" IsEnabled="{Binding !IsBusy}"/>
                <Button Content="{loc:Loc Text.Add}" Classes="Primary" Command="{Binding AddItemCommand}" IsEnabled="{Binding !IsBusy}"/>
            </WrapPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
            <ProgressBar Height="3" IsIndeterminate="{DynamicResource MotionEnabled}" IsVisible="{Binding IsBusy}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
            <TextBlock Text="{Binding Notification}" IsVisible="{Binding Notification, Converter={StaticResource NotNullToBool}}" Classes="Muted" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="2" x:Name="Panels" ColumnDefinitions="360,20,*" RowDefinitions="*">
            <Border x:Name="FridgePanel" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource Divider}" BorderThickness="2" CornerRadius="24" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,8"><TextBlock Text="{loc:Loc Text.YourStock}" Classes="Header"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource ActionPrimary}" VerticalAlignment="Center"/></Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FridgeCategory">
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Margin="3,0,3,6" Padding="0,0,0,4">
                                        <Button Classes="food" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.SelectCategoryCommand}" CommandParameter="{Binding Name}" AutomationProperties.Name="{Binding AccessibleName}">
                                            <StackPanel Spacing="4">
                                                <controls:FridgeFoodIllustration Kind="{Binding Illustration}" Opacity="{Binding IllustrationOpacity}"/>
                                                <Border Classes="FoodNameSlot"><TextBlock Text="{loc:Display Name}" Classes="FoodName" MaxLines="2" ToolTip.Tip="{loc:Display Name}"/></Border>
                                                <TextBlock Text="{Binding Summary}" Classes="Muted FoodCount"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="{loc:Loc Text.SelectAProductToSeeItsCategory}" Classes="Muted FridgeHint" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </Grid>
            </Border>
            <Grid x:Name="StockPanel" Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Display CategoryTitle}" Classes="Header" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="{loc:Loc Text.All}" Classes="Secondary" Command="{Binding SelectCategoryCommand}" ToolTip.Tip="{loc:Loc Text.AllIngredients}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,150,Auto" Margin="0,0,0,8">
                    <TextBox Text="{Binding SearchTerm}" Watermark="{loc:Loc Text.SearchIngredients}" AutomationProperties.Name="{loc:Loc Text.SearchSelectedCategory}" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SortOrders}" SelectedItem="{Binding SortOrder}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Text.SortIngredients}" Margin="0,0,6,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Button Grid.Column="2" Classes="Secondary StockIcon" Command="{Binding RetryCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{loc:Loc Text.ReloadTryAgain}" AutomationProperties.Name="{loc:Loc Text.ReloadPantry}">
                        <Path Width="18" Height="18" Stretch="Uniform" Data="M 18,8 A 7,7 0 1 0 19,14 M 18,3 L 18,8 L 13,8" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" StrokeLineCap="Round"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding DisplayRows}" Background="Transparent" Padding="0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FridgeStockRow">
                                <StackPanel>
                                <TextBlock Text="{loc:Display Item.CategoryName}" IsVisible="{Binding StartsCategory}" Classes="Muted" FontWeight="SemiBold" Margin="4,8,0,6"/>
                                <Border Classes="Card" Margin="0,0,0,6" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="{Binding Item.IngredientName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Row="1" Spacing="2" Margin="0,4,8,0">
                                            <TextBlock Text="{loc:Display Item.CategoryName}" Classes="Muted" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding Item.Quantity, StringFormat='{}{0:0.##}'}"/><TextBlock Text="{Binding Item.UnitAbbreviation}"/></StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsEnabled="{Binding !$parent[UserControl].DataContext.IsBusy}">
                                            <Button Content="{loc:Loc Text.Edit}" Classes="Secondary" Padding="8,4" Command="{Binding $parent[UserControl].DataContext.EditItemCommand}" CommandParameter="{Binding Item}"/>
                                            <Button Classes="Danger StockIcon" Command="{Binding $parent[UserControl].DataContext.RemoveItemCommand}" CommandParameter="{Binding Item}" ToolTip.Tip="{loc:Loc Text.RemoveFromPantry}" AutomationProperties.Name="{loc:Loc Text.RemoveFromPantry}">
                                                <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource OnDanger}" StrokeThickness="1.7"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" Classes="Muted" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280" TextAlignment="Center" Margin="12"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
