<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:controls="using:MealPrepApp.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MealPrepApp.ViewModels.Ingrediente" xmlns:models="using:MealPrepApp.Models" x:Class="MealPrepApp.Desktop.Views.Ingrediente.IngredientAddDialog" x:DataType="vm:IngredientAddDialogViewModel" Title="{Binding EditorTitle}" Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <controls:DialogLayout>
        <Border Grid.Row="0" Classes="DialogHeading">
            <Grid ColumnDefinitions="32,*"><Path Data="{StaticResource IconIngredient}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding EditorTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,8" Spacing="12">
            <TextBlock Text="{loc:Loc Text.Name}" Classes="Muted"/>
            <TextBox Text="{Binding Name}" MaxLength="100"/>
            <TextBlock Text="{loc:Loc Text.DefaultUnit}" Classes="Muted"/>
            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Unit">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{loc:Loc Text.Category}" Classes="Muted"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:IngredientCategory">
                        <TextBlock Text="{loc:Display Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{loc:Loc UX.DefaultUnitFuture}" IsVisible="{Binding IsEdit}" Classes="Muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,4,0,0"/>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Classes="DialogFooter">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc Text.Cancel}" Classes="Secondary DialogCancel" Click="OnCancelClick"/>
                <Button Content="{loc:Loc Text.Save}" Classes="Primary" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Border>
    </controls:DialogLayout>
</Window>
