<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MealPrepApp.ViewModels.Planificare"
             xmlns:models="using:MealPrepApp.Models"
             x:Class="MealPrepApp.Desktop.Views.Planificare.PlanificareWeeklyView"
             x:DataType="vm:PlanificareWeeklyViewModel"
             Background="{StaticResource CreamBrush}">

    <UserControl.Styles>
        <Style Selector="Button.WeekCell">
            <Setter Property="Background" Value="{StaticResource Cream2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.WeekCell:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource MossLightBrush}" />
        </Style>

        <Style Selector="Button.MealChip">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.MealChip:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,8,24,16">
        <!-- Week navigation -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="◀" Classes="Secondary"
                    Command="{Binding PrevWeekCommand}" />
            <Button DockPanel.Dock="Left" Content="Saptamana curenta" Classes="Secondary"
                    Margin="8,0,0,0" Command="{Binding ThisWeekCommand}" />
            <Button DockPanel.Dock="Right" Content="▶" Classes="Secondary"
                    Command="{Binding NextWeekCommand}" />
            <TextBlock Text="{Binding WeekLabel}"
                       FontWeight="Bold" FontSize="{StaticResource FontSizeHeader}"
                       VerticalAlignment="Center" Margin="20,0,0,0" />
        </DockPanel>

        <!-- Slot column headers -->
        <Grid Grid.Row="1" ColumnDefinitions="90,*" Margin="0,0,0,6">
            <ItemsControl Grid.Column="1" ItemsSource="{Binding SlotHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Classes="Muted"
                                   HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Day rows -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WeekRowViewModel">
                        <Grid ColumnDefinitions="90,*" Margin="0,0,0,4">
                            <!-- Day label header -->
                            <Border Grid.Column="0" Background="{StaticResource DarkBrush}"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0.5"
                                    CornerRadius="3,0,0,3">
                                <TextBlock Text="{Binding DayLabel}" Foreground="{StaticResource CreamBrush}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <!-- 4 Meal slots -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekCellViewModel">
                                        <Button Classes="WeekCell"
                                                Command="{Binding ((vm:PlanificareWeeklyViewModel)DataContext).AddInCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MealPlanEntry">
                                                        <Button Classes="MealChip"
                                                                Background="{Binding CategoryID, Converter={StaticResource CategoryIdToBrush}}"
                                                                Command="{Binding ((vm:PlanificareWeeklyViewModel)DataContext).EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding RecipeTitle}"
                                                                       Foreground="{StaticResource CreamBrush}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
