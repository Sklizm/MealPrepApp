<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MealPrepApp.ViewModels.Planificare"
        xmlns:models="using:MealPrepApp.Models"
        x:Class="MealPrepApp.Desktop.Views.Planificare.PlanMealDialog"
        x:DataType="vm:PlanMealDialogViewModel"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CreamBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource DarkBrush}" Height="40" Padding="16,0">
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource CreamBrush}"
                       FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Form body -->
        <StackPanel Grid.Row="1" Margin="20" Spacing="8">
            <!-- Recipe: autocomplete when adding, read-only box when editing -->
            <TextBlock Text="Reteta *" Classes="Muted" />
            <AutoCompleteBox ItemsSource="{Binding RecipeResults}"
                             Text="{Binding RecipeSearchTerm, Mode=TwoWay}"
                             SelectedItem="{Binding SelectedRecipe}"
                             ValueMemberBinding="{Binding Title}"
                             FilterMode="None"
                             IsVisible="{Binding CanPickRecipe}">
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="models:RecipeListItem">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <TextBox Text="{Binding FixedRecipeTitle}" IsReadOnly="True"
                     IsVisible="{Binding IsEdit}" />

            <!-- Meal slot -->
            <TextBlock Text="Masa *" Classes="Muted" />
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Date -->
            <TextBlock Text="Data *" Classes="Muted" />
            <DatePicker SelectedDate="{Binding PlannedDate, Converter={StaticResource DateTimeToDateTimeOffset}}"
                        HorizontalAlignment="Left" />

            <!-- Servings -->
            <TextBlock Text="Portii (optional)" Classes="Muted" />
            <TextBox Text="{Binding Servings}" Width="100" HorizontalAlignment="Left" />

            <!-- Notes -->
            <TextBlock Text="Notite (optional)" Classes="Muted" />
            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

            <!-- Error message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding HasError}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Cream2Brush}" Padding="16,10">
            <Grid>
                <!-- Sterge button (edit mode only) -->
                <Button Content="Sterge" Classes="Danger" HorizontalAlignment="Left"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEdit}"
                        IsEnabled="{Binding !IsBusy}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Renunta" Classes="Secondary" Click="OnCancelClick" />
                    <Button Content="Salveaza" Classes="Primary"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
