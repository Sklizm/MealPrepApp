<Window xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:controls="using:MealPrepApp.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MealPrepApp.ViewModels.Planificare" xmlns:models="using:MealPrepApp.Models" x:Class="MealPrepApp.Desktop.Views.Planificare.PlanMealDialog" x:DataType="vm:PlanMealDialogViewModel" Title="{Binding Title}" Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <controls:DialogLayout>
        <!-- Title bar -->
        <Border Grid.Row="0" Classes="DialogHeading">
            <Grid ColumnDefinitions="32,*"><Path Data="{StaticResource IconPlan}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
        </Border>
        <!-- Form body -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,8" Spacing="12">
            <!-- Recipe: autocomplete when adding, read-only box when editing -->
            <TextBlock Text="{loc:Loc Text.Recipe}" Classes="Muted"/>
            <AutoCompleteBox ItemsSource="{Binding RecipeResults}" Text="{Binding RecipeSearchTerm, Mode=TwoWay}" SelectedItem="{Binding SelectedRecipe}" ValueMemberBinding="{Binding Title}" FilterMode="None" IsVisible="{Binding CanPickRecipe}">
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="models:RecipeListItem">
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <TextBox Text="{Binding FixedRecipeTitle}" IsReadOnly="True" IsVisible="{Binding IsEdit}"/>
            <!-- Meal slot -->
            <TextBlock Text="{loc:Loc Text.Meal}" Classes="Muted"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <TextBlock Text="{loc:Display Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Date -->
            <TextBlock Text="{loc:Loc Text.Date}" Classes="Muted"/>
            <loc:LocalizedCalendarDatePicker Width="152" SelectedDate="{Binding PlannedDate}" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Text.Date}"/>
            <!-- Servings -->
            <TextBlock Text="{loc:Loc Text.ServingsOptional}" Classes="Muted"/>
            <TextBox Text="{Binding Servings}" Width="100" HorizontalAlignment="Left"/>
            <!-- Notes -->
            <TextBlock Text="{loc:Loc Text.NotesOptional}" Classes="Muted"/>
            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
            <!-- Error message -->
            <Expander Header="{loc:Loc UX.MultipleDates}" IsVisible="{Binding !IsEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <Button Content="{loc:Loc UX.AddSelectedDate}" Command="{Binding AddDateCommand}" Classes="Secondary"/>
                    <ItemsControl ItemsSource="{Binding AdditionalDates}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding StringFormat='{}{0:d}'}" Command="{Binding $parent[Window].DataContext.RemoveDateCommand}" CommandParameter="{Binding}" Classes="Secondary"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{loc:Loc UX.UsePreparedBatch}" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding PreparedBatches}" SelectedItem="{Binding SelectedPreparedBatch}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc UX.UsePreparedBatch}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:CookingBatch"><TextBlock Text="{Binding PreparedLabel}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Button Content="{loc:Loc UX.UseNewBatch}" Command="{Binding UseNewBatchCommand}" Classes="Secondary"/>
                    <CheckBox Content="{loc:Loc UX.OneCookingBatch}" IsChecked="{Binding IsBatchPlan}"/>
                    <TextBlock Text="{loc:Loc UX.BatchPortionsHint}" TextWrapping="Wrap" Classes="Muted"/>
                    <NumericUpDown Value="{Binding BatchPortions}" Minimum="1" Maximum="1000" FormatString="0.####" IsEnabled="{Binding IsBatchPlan}" AutomationProperties.Name="{loc:Loc UX.ProducedPortions}"/>
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="0,4,0,0"/>
        </StackPanel></ScrollViewer>
        <!-- Footer -->
        <Border Grid.Row="2" Classes="DialogFooter">
            <Grid>
                <!-- Delete button (edit mode only) -->
                <Button Content="{loc:Loc Text.Delete}" Classes="DestructiveLink" HorizontalAlignment="Left" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEdit}" IsEnabled="{Binding !IsBusy}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc Text.Cancel}" Classes="Secondary DialogCancel" Click="OnCancelClick"/>
                    <Button Content="{loc:Loc Text.Save}" Classes="Primary" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
                </StackPanel>
            </Grid>
        </Border>
    </controls:DialogLayout>
</Window>
