<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:MealPrepApp.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MealPrepApp.ViewModels.Rapoarte" xmlns:models="using:MealPrepApp.Models" x:Class="MealPrepApp.Desktop.Views.Rapoarte.ListaCumparaturiPrintView" x:DataType="vm:ListaCumparaturiPrintViewModel" Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32">
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="{loc:Loc Text.PrintableShoppingList}" FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold" Margin="0,0,0,16"/>
        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Loc Text.From}" Classes="Muted" VerticalAlignment="Center"/>
                <loc:LocalizedCalendarDatePicker Width="152" SelectedDate="{Binding StartDate}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Text.From}"/>
                <TextBlock Text="{loc:Loc Text.To163}" Classes="Muted" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <loc:LocalizedCalendarDatePicker Width="152" SelectedDate="{Binding EndDate}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Text.To}"/>
                <Button Content="{loc:Loc Text.Generate}" Classes="Primary" Margin="8,0,0,0" Command="{Binding GenereazaCommand}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Loc Text.ExportExcel}" Classes="Secondary" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding Rows.Count, Converter={StaticResource NonEmptyToBool}}"/>
            </StackPanel>
        </DockPanel>
        <!-- Error message -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,8">
            <ProgressBar Height="4" IsIndeterminate="{DynamicResource MotionEnabled}" IsVisible="{Binding IsBusy}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
            <Button Content="{loc:Loc Text.TryAgain}" Classes="Secondary" Command="{Binding GenereazaCommand}" IsVisible="{Binding HasError}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left"/>
        </StackPanel>
        <!-- Content -->
        <Grid Grid.Row="3">
            <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Rows}" IsReadOnly="True" CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" IsVisible="{Binding Rows.Count, Converter={StaticResource NonEmptyToBool}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Text.Ingredient165}" Binding="{Binding IngredientName}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Loc Text.Required}" Binding="{Binding NeededQty, StringFormat={}{0:0.##}}" Width="110"/>
                    <DataGridTextColumn Header="{loc:Loc Text.InPantry}" Binding="{Binding OnHandQty, StringFormat={}{0:0.##}}" Width="110"/>
                    <DataGridTextColumn Header="{loc:Loc Text.ToBuy}" Binding="{Binding ToBuyQty, StringFormat={}{0:0.##}}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Loc Text.Unit169}" Binding="{Binding UnitAbbreviation}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- Empty / ungenerated state -->
            <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.IsVisible>
                    <MultiBinding Converter="{StaticResource ShowEmpty}">
                        <Binding Path="Rows.Count"/>
                        <Binding Path="IsBusy"/>
                        <Binding Path="HasError"/>
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="{loc:Loc Text.SelectADateRangeAndPressGenerate}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Text.TheListUsesPlannedMealsMinusWhatIsAlreadyInYourPantry}" Classes="Muted" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
