<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="using:MealPrepApp.Desktop.Converters" xmlns:vm="using:MealPrepApp.ViewModels" xmlns:authvm="using:MealPrepApp.ViewModels.Auth" xmlns:retetevm="using:MealPrepApp.ViewModels.Retete" xmlns:ingvm="using:MealPrepApp.ViewModels.Ingrediente" xmlns:planvm="using:MealPrepApp.ViewModels.Planificare" xmlns:rapvm="using:MealPrepApp.ViewModels.Rapoarte" xmlns:views="using:MealPrepApp.Desktop.Views" xmlns:authviews="using:MealPrepApp.Desktop.Views.Auth" xmlns:reteteviews="using:MealPrepApp.Desktop.Views.Retete" xmlns:ingviews="using:MealPrepApp.Desktop.Views.Ingrediente" xmlns:planviews="using:MealPrepApp.Desktop.Views.Planificare" xmlns:rapviews="using:MealPrepApp.Desktop.Views.Rapoarte" x:Class="MealPrepApp.Desktop.App" RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Colors.axaml"/>
                <ResourceInclude Source="/Themes/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:EmptyStateConverter x:Key="ShowEmpty"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>
            <conv:NotNullToBoolConverter x:Key="NotNullToBool"/>
            <conv:EmptyCollectionToBoolConverter x:Key="EmptyToBool"/>
            <conv:NonEmptyCollectionToBoolConverter x:Key="NonEmptyToBool"/>
            <conv:StringEqualsConverter x:Key="StringEquals"/>
            <conv:DateTimeToDateTimeOffsetConverter x:Key="DateTimeToDateTimeOffset"/>
            <conv:BoolToOpacityConverter x:Key="BoolToOpacity"/>
            <conv:IsTodayToBrushConverter x:Key="IsTodayToBrush"/>
            <conv:CategoryIdToBrushConverter x:Key="CategoryIdToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                    Accent="#78513B"
                    AltHigh="#F0E5D5"
                    AltLow="#F0E5D5"
                    AltMedium="#F0E5D5"
                    AltMediumHigh="#F0E5D5"
                    AltMediumLow="#DDCDB8"
                    BaseHigh="#3F3026"
                    BaseLow="#80644E"
                    BaseMedium="#66503F"
                    BaseMediumHigh="#66503F"
                    BaseMediumLow="#66503F"
                    ChromeAltLow="#DDCDB8"
                    ChromeBlackHigh="#3F3026"
                    ChromeBlackLow="#DDCDB8"
                    ChromeBlackMedium="#66503F"
                    ChromeBlackMediumLow="#80644E"
                    ChromeDisabledHigh="#66503F"
                    ChromeDisabledLow="#DDCDB8"
                    ChromeGray="#80644E"
                    ChromeHigh="#80644E"
                    ChromeLow="#E6D8C5"
                    ChromeMedium="#DDCDB8"
                    ChromeMediumLow="#F0E5D5"
                    ChromeWhite="#F0E5D5"
                    ListLow="#DDCDB8"
                    ListMedium="#D3BFA6"/>
                <ColorPaletteResources x:Key="Dark"
                    Accent="#ACD2B2"
                    AltHigh="#40574B"
                    AltLow="#40574B"
                    AltMedium="#40574B"
                    AltMediumHigh="#40574B"
                    AltMediumLow="#4A6254"
                    BaseHigh="#F0EBDD"
                    BaseLow="#B5CCB4"
                    BaseMedium="#D3DCCE"
                    BaseMediumHigh="#D3DCCE"
                    BaseMediumLow="#D3DCCE"
                    ChromeAltLow="#4A6254"
                    ChromeBlackHigh="#F0EBDD"
                    ChromeBlackLow="#4A6254"
                    ChromeBlackMedium="#D3DCCE"
                    ChromeBlackMediumLow="#B5CCB4"
                    ChromeDisabledHigh="#D3DCCE"
                    ChromeDisabledLow="#4A6254"
                    ChromeGray="#B5CCB4"
                    ChromeHigh="#B5CCB4"
                    ChromeLow="#34483E"
                    ChromeMedium="#4A6254"
                    ChromeMediumLow="#40574B"
                    ChromeWhite="#40574B"
                    ListLow="#4A6254"
                    ListMedium="#536E59"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="/Themes/Styles.axaml"/>
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type retetevm:CookingViewModel}">
            <reteteviews:CookingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcasaViewModel}">
            <views:AcasaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type authvm:ProfileViewModel}">
            <authviews:ProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type retetevm:ReteteListViewModel}">
            <reteteviews:ReteteListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type retetevm:ReteteDetailViewModel}">
            <reteteviews:ReteteDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type retetevm:ReteteEditorViewModel}">
            <reteteviews:ReteteEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ingvm:IngredienteRootViewModel}">
            <ingviews:IngredienteRootView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ingvm:IngredienteListViewModel}">
            <ingviews:IngredienteListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ingvm:FrigiderViewModel}">
            <ingviews:FrigiderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ingvm:ShoppingListViewModel}">
            <ingviews:ShoppingListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type planvm:PlanificareRootViewModel}">
            <planviews:PlanificareRootView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type planvm:PlanificareWeeklyViewModel}">
            <planviews:PlanificareWeeklyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type planvm:PlanificareMonthlyViewModel}">
            <planviews:PlanificareMonthlyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type rapvm:RapoarteRootViewModel}">
            <rapviews:RapoarteRootView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type rapvm:StatisticiLunareViewModel}">
            <rapviews:StatisticiLunareView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type rapvm:PlanSaptamanalPrintViewModel}">
            <rapviews:PlanSaptamanalPrintView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type rapvm:ListaCumparaturiPrintViewModel}">
            <rapviews:ListaCumparaturiPrintView/>
        </DataTemplate>
    </Application.DataTemplates>
</Application>
