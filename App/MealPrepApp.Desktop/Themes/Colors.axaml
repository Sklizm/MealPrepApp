<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackground" Color="#F8F7F4"/>
            <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceSecondary" Color="#EEF2EC"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#202923"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#5F6B63"/>
            <SolidColorBrush x:Key="ActionPrimary" Color="#28654B"/>
            <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Accent" Color="#A64F35"/>
            <SolidColorBrush x:Key="Danger" Color="#A52D36"/>
            <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Divider" Color="#D3DBD1"/>
            <SolidColorBrush x:Key="ActionHover" Color="#1E523C"/>
            <SolidColorBrush x:Key="ActionPressed" Color="#173E2E"/>
            <SolidColorBrush x:Key="Selection" Color="#DCECDF"/>
            <SolidColorBrush x:Key="Focus" Color="#28654B"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackground" Color="#151C18"/>
            <SolidColorBrush x:Key="Surface" Color="#1D2721"/>
            <SolidColorBrush x:Key="SurfaceSecondary" Color="#26332B"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#EDF2EC"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A6B4A9"/>
            <SolidColorBrush x:Key="ActionPrimary" Color="#8BC5A3"/>
            <SolidColorBrush x:Key="OnPrimary" Color="#11251A"/>
            <SolidColorBrush x:Key="Accent" Color="#D9987E"/>
            <SolidColorBrush x:Key="Danger" Color="#F3A2A8"/>
            <SolidColorBrush x:Key="OnDanger" Color="#391217"/>
            <SolidColorBrush x:Key="Divider" Color="#48594C"/>
            <SolidColorBrush x:Key="ActionHover" Color="#A1D4B6"/>
            <SolidColorBrush x:Key="ActionPressed" Color="#71B28C"/>
            <SolidColorBrush x:Key="Selection" Color="#344F3D"/>
            <SolidColorBrush x:Key="Focus" Color="#8BC5A3"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush x:Key="MealBreakfast" Color="#8B4331"/>
    <SolidColorBrush x:Key="MealLunch" Color="#28654B"/>
    <SolidColorBrush x:Key="MealDinner" Color="#365776"/>
    <SolidColorBrush x:Key="MealSnack" Color="#78531A"/>
    <SolidColorBrush x:Key="MealDessert" Color="#694770"/>
    <SolidColorBrush x:Key="MealDrink" Color="#315F6B"/>
    <SolidColorBrush x:Key="OnMeal" Color="White"/>
    <FontFamily x:Key="AppFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <x:Double x:Key="FontSizeTitle">28</x:Double>
    <x:Double x:Key="FontSizeHeader">20</x:Double>
    <x:Double x:Key="FontSizeAction">14</x:Double>
    <x:Double x:Key="FontSizeMenu">14</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
</ResourceDictionary>
